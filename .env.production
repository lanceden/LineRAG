# 生產環境配置
# 複製到 .env 使用

# LLM 設定 (生產環境使用 vLLM)
OPENAI_API_BASE=http://vllm:8000/v1
OPENAI_API_KEY=not-needed
LLM_MODEL_NAME=TheBloke/Qwen2-7B-Chat-AWQ

# 向量資料庫設定
EMBEDDING_MODEL_NAME=BAAI/bge-m3
USE_LOCAL_QDRANT=false
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_STORAGE_PATH=./data/qdrant
COLLECTION_NAME=documents

# LINE Bot 設定（生產環境必填）
LINE_CHANNEL_ACCESS_TOKEN=your_production_line_token
LINE_CHANNEL_SECRET=your_production_line_secret
LINE_CLIENT_ID=your_production_line_client_id
LINE_CLIENT_SECRET=your_production_line_client_secret
LINE_REPLY_ENDPOINT=https://api.line.me/v2/bot/message/reply

# Next.js 設定
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your_strong_production_secret_key

# Redis 設定
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# 其他設定
UPLOAD_IMAGE_DIR=/app/uploads/images
LOG_LEVEL=INFO
CHUNK_SIZE=1000
CHUNK_OVERLAP=200