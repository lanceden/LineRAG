# LineRAG 統一環境配置
# 複製此文件為 .env 並修改必要的值

# ========================================
# 🔴 必須配置
# ========================================

# 資料庫連接 (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/linerag

# OpenAI GPT API 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Neo4j 知識圖譜資料庫 (LightRAG 配置)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=linerag123
NEO4J_WORKSPACE=linerag

# Qdrant 向量資料庫 (LightRAG 配置)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_WORKSPACE=linerag

# ========================================
# 🟡 Web 前端配置 (如需要)
# ========================================

# NextAuth 設定
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# API 端點
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000/api
PYTHON_API_URL=http://localhost:8000/api

# LINE Login (可選)
# LINE_CLIENT_ID=your_line_client_id
# LINE_CLIENT_SECRET=your_line_client_secret

# ========================================
# 🟡 LINE Bot 配置 (如需要)
# ========================================

# LINE_CHANNEL_ACCESS_TOKEN=your_token
# LINE_CHANNEL_SECRET=your_secret

# ========================================
#  其他設定 (可使用預設值)
# ========================================

# LOG_LEVEL=INFO
# UPLOAD_IMAGE_DIR=/app/uploads/images
